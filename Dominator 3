local MAX_FORWARD_STUDS, MAX_REVERSE_STUDS = 128, 38
local STUDS_TO_MPH = 95 / MAX_FORWARD_STUDS
local currentPitch, currentTurn = 1.0, 0
RunService.Heartbeat:Connect(function(dt)
if not target.Parent or not chassis.Parent then setMuffle(false) return end
local head = char and char:FindFirstChild("Head")
local zoomDist = head and (camera.CFrame.Position - head.Position).Magnitude or 999
setMuffle(isSeated and not camActive and zoomDist <= 2.2)
local locked = driveState.deployed or driveState.engineKillOverride or not driveState.canDrive or not isSeated or activeSeat ~= soundDriverSeat
local rayParams = RaycastParams.new()
rayParams.FilterDescendantsInstances = {target, char}
rayParams.FilterType = Enum.RaycastFilterType.Exclude
local groundHit = workspace:Raycast(chassis.Position + Vector3.new(0, 2, 0), Vector3.new(0, -10, 0), rayParams)
local isOffroad = groundHit and (groundHit.Material == Enum.Material.Grass or groundHit.Material == Enum.Material.Mud or groundHit.Material == Enum.Material.Sand or groundHit.Material == Enum.Material.Ground)
local maxFwd = isOffroad and (MAX_FORWARD_STUDS * 0.72) or MAX_FORWARD_STUDS
local maxRev = isOffroad and (MAX_REVERSE_STUDS * 0.75) or MAX_REVERSE_STUDS
if locked then
driveState.currentSpeed, currentTurn = 0, 0
vehicleEngine.PlaneVelocity = Vector2.zero
vehicleSteer.AngularVelocity = Vector3.zero
else
local absSp = math.abs(driveState.currentSpeed)
if inputState.brake then
local decel = 145 * dt
driveState.currentSpeed = driveState.currentSpeed > 0 and math.max(0, driveState.currentSpeed - decel) or math.min(0, driveState.currentSpeed + decel)
elseif inputState.forward then
local curve = math.clamp(1.25 - (absSp / maxFwd) * 0.85, 0.28, 1.25)
driveState.currentSpeed = math.min(maxFwd, driveState.currentSpeed + 46 * curve * dt)
elseif inputState.reverse then
local curve = math.clamp(1.2 - (absSp / maxRev) * 0.75, 0.35, 1.2)
driveState.currentSpeed = math.max(-maxRev, driveState.currentSpeed - 34 * curve * dt)
else
local drag = 18 * dt
if driveState.currentSpeed > maxFwd then driveState.currentSpeed = math.max(maxFwd, driveState.currentSpeed - 40 * dt)
elseif driveState.currentSpeed > 0 then driveState.currentSpeed = math.max(0, driveState.currentSpeed - drag)
elseif driveState.currentSpeed < -maxRev then driveState.currentSpeed = math.min(-maxRev, driveState.currentSpeed + 40 * dt)
elseif driveState.currentSpeed < 0 then driveState.currentSpeed = math.min(0, driveState.currentSpeed + drag) end
end
local fwd = chassis.CFrame.LookVector
vehicleEngine.PlaneVelocity = Vector2.new(fwd.X * driveState.currentSpeed, fwd.Z * driveState.currentSpeed)
local targetTurn = 0
if absSp > 0.5 and (inputState.left or inputState.right) then
local rate = math.clamp(1.32 - (math.clamp(absSp / maxFwd, 0, 1) * 0.72), 0.52, 1.32) * (isOffroad and 0.85 or 1)
local dir = driveState.currentSpeed < 0 and -1 or 1
if inputState.left and not inputState.right then
targetTurn = rate * dir
elseif inputState.right and not inputState.left then
targetTurn = -rate * dir
end
end
local lagRate = (targetTurn ~= 0) and 3.2 or 6.5
currentTurn += (targetTurn - currentTurn) * math.clamp(lagRate * dt, 0, 1)
if targetTurn == 0 and math.abs(currentTurn) < 0.015 then
currentTurn = 0
end
vehicleSteer.AngularVelocity = Vector3.new(0, currentTurn, 0)
end
speedText.Text = string.format("%03d", math.abs(math.floor(driveState.currentSpeed * STUDS_TO_MPH + 0.5)))
if idleSound.IsPlaying and not driveState.engineKillOverride then
local speedNorm = math.clamp(math.abs(driveState.currentSpeed) / MAX_FORWARD_STUDS, 0, 1)
local gearRpm = (speedNorm > 0.02) and (0.25 + ((speedNorm * 5) % 1) * 0.75) or 0
local targetPitch = 1.0 + (speedNorm * 0.65) + (gearRpm * 0.28) + ((inputState.forward or inputState.reverse) and 0.14 or 0)
currentPitch += (targetPitch - currentPitch) * math.clamp(8 * dt, 0, 1)
idleSound.PlaybackSpeed = math.clamp(currentPitch, 0.95, 2.05)
else
currentPitch, idleSound.PlaybackSpeed = 1.0, 1.0
end
end)
end
