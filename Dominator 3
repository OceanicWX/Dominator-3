local isMuffled, cabinEQs = false, {}
local function applyMuffle(s)
if not s:IsA("Sound") or cabinEQs[s] then return end
local ok, eq = pcall(function()
local e = s:FindFirstChild("D3MuffleEQ") or Instance.new("EqualizerSoundEffect")
e.Name = "D3MuffleEQ"
e.HighGain, e.MidGain, e.LowGain, e.Priority = -35, -16, 2.5, 10
e.Enabled = isMuffled
e.Parent = s
return e
end)
if ok and eq then
cabinEQs[s] = eq
s.Destroying:Connect(function() cabinEQs[s] = nil end)
end
end
for _, v in ipairs(game:GetDescendants()) do if v:IsA("Sound") then applyMuffle(v) end end
local soundConn
soundConn = game.DescendantAdded:Connect(function(v)
if not target.Parent then soundConn:Disconnect() return end
if v:IsA("Sound") then applyMuffle(v) end
end)
local function setMuffle(state)
if isMuffled == state then return end
isMuffled = state
for s, eq in pairs(cabinEQs) do
if s.Parent and eq.Parent then eq.Enabled = state else cabinEQs[s] = nil end
end
end
local function stopEngine()
engineSession += 1
if startupSound.IsPlaying then startupSound:Stop() end
if idleSound.IsPlaying then idleSound:Stop() end
idleSound.PlaybackSpeed = 1.0
end
local function startEngine()
if driveState.engineKillOverride then return end
engineSession += 1
local cs = engineSession
stopEngine()
engineSession = cs
startupSound:Play()
startupSound.Ended:Once(function()
if engineSession == cs and isSeated and not driveState.engineKillOverride and target.Parent then
idleSound:Play()
end
end)
end
