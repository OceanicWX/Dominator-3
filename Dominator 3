if driveState.engineKillOverride or not driveState.canDrive or driveState.deployed then return end
activeInput = i
if key == "forward" then inputState.reverse = false elseif key == "reverse" then inputState.forward = false end
inputState[key] = true
btn.BackgroundTransparency = 0.1
if activeColor then btn.TextColor3 = activeColor end
end
end)
btn.InputEnded:Connect(function(i) if i == activeInput then release() end end)
btn.MouseLeave:Connect(function()
