local function bindSeat(custom, orig, isDriver)
if orig:IsA("Seat") or orig:IsA("VehicleSeat") then orig.Disabled = true end
custom.Size, custom.Transparency = orig.Size, orig.Transparency
custom.CFrame = orig.CFrame * CFrame.new(0, 0.8, 0)
custom.Parent = orig
if isDriver and not soundDriverSeat then soundDriverSeat = custom end
custom.Touched:Connect(function(hit) if hit.Parent == char then enterSeat(custom, isDriver) end end)
local w = Instance.new("Weld", chassis)
w.Part0, w.Part1 = chassis, custom
w.C0 = chassis.CFrame:ToObjectSpace(custom.CFrame)
table.insert(bodyWelds, { weld = w, baseC0 = w.C0 })
table.insert(bodyParts, custom)
table.insert(allParts, custom)
end
